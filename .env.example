# Copy this file to .env and fill in your own values.
# (The server reads plain environment variables — on Render/Vercel you set these in the
#  dashboard rather than in a file.)

# Port the API server listens on locally. Default: 3001
PORT=3001

# Password for the results endpoints (/api/admin/responses and .csv).
# Pick something long and random — anyone with this string can read every response.
ADMIN_KEY=change-me-to-a-long-random-string

# Folder where the SQLite database file (responses.db) is written. Default: ./data
# On Render this is set to the mounted disk: /var/data
DATA_DIR=./data

# Optional. If set, responses go to Postgres instead of SQLite.
# Required on Vercel (no persistent disk there). A free Neon database works well.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
