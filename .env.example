# Copy this file to .env and fill in your own values.
# (The server reads plain environment variables — on Render/Vercel you set these in the
#  dashboard rather than in a file.)

# Port the API server listens on locally. Default: 3001
PORT=3001

# Password for the results endpoints (/api/admin/responses and .csv).
# Pick something long and random — anyone with this string can read every response.
ADMIN_KEY=change-me-to-a-long-random-string

# Folder where the SQLite database file (responses.db) is written. Default: ./data
# On Render this is set to the mounted disk: /var/data
DATA_DIR=./data

# Optional. If set, responses go to Postgres instead of SQLite.
# Required on Vercel (no persistent disk there). A free Neon database works well.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Email notifications (optional) ---------------------------------------------
# When all of MS_TENANT_ID, MS_CLIENT_ID, MS_CLIENT_SECRET and MAIL_FROM are set, every new
# response emails NOTIFY_TO a summary plus the updated results report (HTML attachment),
# sent from MAIL_FROM through Microsoft Graph. See README "Email notifications".
# MS_TENANT_ID=00000000-0000-0000-0000-000000000000
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_CLIENT_SECRET=the-secret-VALUE-shown-once-in-Entra
# MAIL_FROM=John_Adams@LetsKetchup.org
# NOTIFY_TO=teammate@LetsKetchup.org, another@LetsKetchup.org   # defaults to MAIL_FROM
# NOTIFY_DRY_RUN=1            # log instead of sending (handy locally)
# SURVEY_SENT_AT=2026-09-23   # rows before this date are test submissions; excluded from the report
